# Copy to .env (never commit .env). Leave the keys blank: the local agent works offline.
# Optional cloud AI via OpenRouter (https://openrouter.ai/keys). Models ending in :free cost nothing.
# A comma-separated list is tried in order when a free model is busy.
# When OPENROUTER_API_KEY is set it is used instead of OPENAI_API_KEY. Each message still needs consent in the app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free
# More providers: fill any you have. MoneyGuard tries them in MONEYGUARD_AI_ORDER and moves on when one is busy.
# Google AI Studio (free tier, good at Bangla): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq (free tier, very fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Microphone transcription for browsers without a working built-in speech service (Firefox, Brave,
# and Edge/Safari when theirs fails). Order: local model, then Groq, then Gemini. With no speech key set,
# GROQ_API_KEY or GEMINI_API_KEY above is reused, so one free key enables dictation in every browser.
MONEYGUARD_SPEECH_MODEL_DIR=
MONEYGUARD_SPEECH_GROQ_API_KEY=
MONEYGUARD_SPEECH_GEMINI_API_KEY=
MONEYGUARD_SPEECH_GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
# Any other OpenAI-compatible service (https only). Only use services you trust: your questions pass through them.
CUSTOM_AI_NAME=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
MONEYGUARD_AI_ORDER=gemini,groq,openrouter,custom
# Optional cloud AI via OpenAI (used only when none of the providers above has a key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MONEYGUARD_HOST=127.0.0.1
MONEYGUARD_PORT=8787
# Optional cross-platform local inference. Leave blank to use the default path.
# Configure only locally installed models; do not select a cloud model alias.
MONEYGUARD_LOCAL_MODEL_URL=
MONEYGUARD_LOCAL_TEXT_MODEL=
MONEYGUARD_LOCAL_VISION_MODEL=
# Set to 1 only when your trusted local server supports JSON Schema output.
# This constrains plan shape; all normal tool/approval checks still apply.
MONEYGUARD_LOCAL_STRUCTURED_PLANS=0
# Optional additional Inbox warning classification by the configured local model.
# Every draft still needs human review; model labels never grant permissions.
MONEYGUARD_SEMANTIC_SCREENING=0
# Optional decision support workspace. Set to 0 to hide and disable its routes/tools.
MONEYGUARD_DECISION_LAB=1
